{
  "name": "followup-app",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform FollowUp client built with HTML, CSS, jQuery, PWA and Capacitor.",
  "type": "module",
  "scripts": {
    "prepare:web": "node scripts/copy-vendor.mjs",
    "start": "npm run prepare:web && http-server www -p 5173 -c-1",
    "sync": "npm run prepare:web && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "jquery": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "http-server": "^14.1.1"
  }
}
